{
  "__inputs": [],
  "__elements": {},
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "9.0.0"
    },
    {
      "type": "datasource",
      "id": "graphite",
      "name": "Graphite",
      "version": "1.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "datasource",
          "uid": "grafana"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "title": "Network Status",
      "type": "gauge",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "target": "alias(smart_home.network.hub.status, 'Hub Status')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "Offline",
                  "color": "red"
                },
                "1": {
                  "text": "Online",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "title": "Devices Online",
      "type": "stat",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "target": "sumSeries(smart_home.devices.*.status)"
        }
      ]
    },
    {
      "title": "UPS Battery Level",
      "type": "gauge",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "target": "alias(smart_home.battery.ups.level, 'UPS Level')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 20 },
              { "color": "green", "value": 50 }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "title": "Storm Mode Active",
      "type": "stat",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "targets": [
        {
          "refId": "A",
          "target": "alias(smart_home.system.storm_mode, 'Storm Mode')"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": { "text": "Disabled", "color": "green" },
                "1": { "text": "Active", "color": "red" }
              }
            }
          ]
        },
        "overrides": []
      }
    },
    {
      "title": "Power Consumption",
      "type": "timeseries",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(smart_home.power.*.watts, 2)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      }
    },
    {
      "title": "Temperature by Room",
      "type": "timeseries",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(smart_home.sensors.*.temperature, 2)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": []
      }
    },
    {
      "title": "Device Response Times",
      "type": "timeseries",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(smart_home.network.*.ping, 2)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "title": "Motion Events",
      "type": "barchart",
      "datasource": {
        "type": "graphite",
        "uid": "graphite"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "target": "aliasByNode(smart_home.sensors.*.motion, 2)"
        }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 36,
  "style": "dark",
  "tags": ["smart-home", "offline"],
  "templating": {
    "list": []
  },
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "title": "Smart Home Offline System",
  "uid": "sh_offline_dash_01",
  "version": 1
}
