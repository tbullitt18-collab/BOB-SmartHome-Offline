{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BOBPolicySchema",
  "description": "Schema for versioned, testable Automation-as-Code policies",
  "type": "object",
  "required": ["policy_id", "version", "name", "priority", "rules"],
  "properties": {
    "policy_id": { "type": "string" },
    "version": { "type": "string", "pattern": "^v[0-9]+\\.[0-9]+(\\.[0-9]+)?$" },
    "name": { "type": "string" },
    "priority": { "type": "integer", "minimum": 1, "maximum": 100 },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "trigger_event", "actions"],
        "properties": {
          "rule_id": { "type": "string" },
          "trigger_event": { "type": "string" },
          "conditions": { "type": "object" },
          "ai_inference": {
            "type": "object",
            "properties": {
              "model_name": { "type": "string" },
              "model_version": { "type": "string" },
              "min_confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 }
            }
          },
          "actions": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["target", "command", "parameters"],
              "properties": {
                "target": { "type": "string" },
                "command": { "type": "string" },
                "parameters": { "type": "object" },
                "requires_approval": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
