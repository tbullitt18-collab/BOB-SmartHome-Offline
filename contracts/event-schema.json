{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BOBDeviceEvent",
  "description": "Normalized event schema for all physical and virtual smart home devices in BOB",
  "type": "object",
  "required": ["event_id", "type", "source", "timestamp", "payload"],
  "properties": {
    "event_id": {
      "type": "string",
      "description": "Unique UUID for the event"
    },
    "type": {
      "type": "string",
      "enum": [
        "zigbee.motion.detected",
        "zigbee.contact.opened",
        "zigbee.contact.closed",
        "sensor.temperature.reading",
        "sensor.barometric.reading",
        "power.draw.changed",
        "power.grid.status_changed",
        "battery.ups.level_changed",
        "dev.git.branch_switched",
        "dev.ci.build_status",
        "safety.smoke.detected",
        "system.offline.mode_entered"
      ]
    },
    "source": {
      "type": "string",
      "description": "Canonical identifier for the source device or service (e.g. office.motion_sensor)"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "description": "ISO-8601 timestamp with timezone"
    },
    "payload": {
      "type": "object",
      "description": "Key-value telemetry payload specific to event type",
      "additionalProperties": true
    }
  }
}
